<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Car App Library apps only accept hosts they trust. Apps built with androidx.car.app up to
      1.8.0-beta01 also trust a host that holds this permission; on a phone no system package
      defines it, so we define it (normal protection) and hold it. Newer library versions ignore it
      on phones: those apps need our signing digest in their allow-list instead (see docs).
    -->
    <permission
        android:name="android.car.permission.TEMPLATE_RENDERER"
        android:protectionLevel="normal"
        tools:ignore="ReservedSystemPermission" />
    <uses-permission android:name="android.car.permission.TEMPLATE_RENDERER" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Android 17: reaching the head unit's address on its Wi-Fi (or the LAN) needs this, else
         connections time out silently. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- a car host on the Panel ROM gets it (System N-019): the stick's half pairing dropped and made anew (System I-084) -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Lists AARE under Developer options > Select mock location app: the car's GPS as the
         phone's location while connected (car/PhoneLocationFeed). -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- given by Mate itself over its own adb connection (System L-063): switch wireless debugging on to start Shizuku -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Do Not Disturb while driving (car/DrivingMode), once the user allows it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mate Musik in a folder of the driver's choice on the memory card (System L-100) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- to ask once that Mate is kept out of the battery optimisation (the sound to the car with the screen off) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The car's Phone app: recent calls, contacts, placing calls (through the car's Bluetooth). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The next calendar event on the car's dashboard. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Only granted when Mate is built into the system image as a privileged app: car audio like
         Android Auto, through an audio policy. Ignored on a normal install. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT"
        tools:ignore="ProtectedPermissions" />
    <!-- Car apps are found by querying their services. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Car apps declare these; we only use them, Android Auto defines them when installed. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".AareApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aare">
        <!-- Mate's voices (Kokoro, Piper) as the device's speech engine for every app (17.11.2026) -->
        <service android:name=".speech.MateTtsService" android:label="@string/tts_engine_name" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/mate_tts_engine" />
        </service>
        <activity android:name=".car.PortalPage" android:exported="false" android:label="@string/portal_title" />
        <activity android:name=".speech.MateTtsSample" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".speech.MateTtsCheck" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- For the car apps this app brings itself (the dashboard): the car app library reads it from the application. -->
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />

        <!-- The built-in dashboard: car data and map from the IDmate server, drawn as a car app that this app hosts
             itself. Not exported: it is no app for other hosts (the separate IDmate app is that). -->
        <activity
            android:name=".dash.SetupActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name=".dash.ScanActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- O107: stands in for the car service of the Android Auto app, which Google Maps asks for the vehicle's
             data. Exported because the ROM (switch "Elektroauto") redirects the binding of the target app here;
             the binder says who asks. -->
        <service
            android:name=".host.CarDataService"
            android:exported="true">
            <intent-filter>
                <action android:name="panel.auto.action.CAR_DATA_SERVICE" />
            </intent-filter>
        </service>
        <service
            android:name=".dash.IdmateCarService"
            android:exported="false"
            android:icon="@drawable/dash_ic_app"
            android:label="@string/dash_name">
            <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- The built-in music area: the own Plex server. Not exported: it plays in this app's car screen only.
             It talks to the server over HTTPS only (Plex gives every server an address with a certificate). -->
        <activity
            android:name=".music.MusicSetupActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- System I-142: loading the offline playlists with the screen off -->
        <service
            android:name=".music.MusicDownload"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".music.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:icon="@drawable/music_ic_app"
            android:label="@string/music_name">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Mate's speech recognition (Whisper on the device) for the whole system, chosen as the voice input -->
        <service
            android:name=".speech.MateRecognitionService"
            android:exported="true"
            android:label="@string/voice_service_label"
            android:foregroundServiceType="microphone">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/recognition_service" />
        </service>
        <!-- a voice command on the phone: headset button, assistant gesture -->
        <activity
            android:name=".speech.MateVoiceActivity"
            android:exported="true"
            android:label="@string/voice_service_label"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- keeps the subscribed playlists on the device up to date -->
        <service
            android:name=".music.MusicSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- starts Shizuku through Mate's own wireless debugging a while after the tablet started -->
        <service
            android:name=".service.ShizukuStartJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CarPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Aare" />

        <!-- Wired head units switch the phone to accessory mode with these strings. -->
        <activity
            android:name=".transport.UsbAccessoryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <service
            android:name=".service.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaProjection|microphone|location" />

        <service
            android:name=".notify.CarNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Car tools for the voice assistant (CarControlProvider checks the caller). -->
        <provider
            android:name=".host.CarControlProvider"
            android:authorities="${applicationId}.car"
            android:exported="true" />

        <!-- Shizuku (adb rights without root): car audio including navigation voice. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Optional: touch for the phone screen shown in the car. -->
        <service
            android:name=".mirror.MirrorTouchService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mirror_touch_service" />
        </service>

        <!-- A paired head unit with wireless Android Auto connected over Bluetooth. No
             android:permission: both actions are protected system broadcasts, and BLUETOOTH_CONNECT
             does not exist below API 31, so requiring it of the sender blocked delivery on 8-11. -->
        <receiver
            android:name=".service.WirelessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.UUID" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The pairing code for Mate's own wireless-debugging connection (System L-063), from its notification. -->
        <receiver
            android:name=".adb.SelfAdbCodeReceiver"
            android:exported="false" />

        <!-- "Trust" on the "New head unit" notification. -->
        <receiver
            android:name=".service.TrustReceiver"
            android:exported="false" />
        <!-- The diagnosis log shared as a file (18.11.2026: "nicht als Textkopie ... sondern als Teilen ... eine Datei teilen") -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
