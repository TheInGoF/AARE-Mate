<?xml version="1.0" encoding="utf-8"?>
<!--
  Die Farben von Mate - die EINE Stelle, an der sie festgelegt sind (wie eine CSS-Datei).
  Oberflaeche im Auto (ui/car/Mate.kt), Anmeldeseite der Musik und die Zeichen lesen alle von hier.
  Ein anderes Farbthema = eine zweite Datei dieser Namen (z. B. values-night/ oder ein eigener Ordner), sonst nichts.
-->
<resources>
    <!-- Grund des Bildschirms -->
    <color name="mate_bg">#0D1117</color>
    <!-- noch tiefer als der Grund -->
    <color name="mate_bg_low">#080B10</color>
    <!-- Kacheln und Flaechen -->
    <color name="mate_surface">#161B22</color>
    <!-- hervorgehobene Flaeche, gedrueckte Kachel -->
    <color name="mate_surface_high">#21262D</color>
    <!-- Linien und Raender -->
    <color name="mate_line">#30363D</color>
    <!-- Schrift -->
    <color name="mate_text">#F0F6FC</color>
    <!-- zurueckgenommene Schrift -->
    <color name="mate_text_dim">#8B949E</color>
    <!-- kleine Zeichen neben Schrift -->
    <color name="mate_text_soft">#B8C0CC</color>
    <!-- Randnotiz ueber Bildern -->
    <color name="mate_text_faint">#99FFFFFF</color>
    <!-- DIE Kontrastfarbe: Auswahl, aktive Zeichen, Hauptknopf, Route -->
    <color name="mate_accent">#1DE9B6</color>
    <!-- Schrift und Zeichen auf der Kontrastfarbe -->
    <color name="mate_on_accent">#0E1B2C</color>
    <!-- gewaehlte Kachel: dunkle Stufe der Kontrastfarbe -->
    <color name="mate_accent_container">#0E3B36</color>
    <!-- runde Knoepfe auf der Bedienleiste -->
    <color name="mate_plate">#33FFFFFF</color>
    <!-- Fleck hinter der Bedienleiste (70 %) -->
    <color name="mate_scrim">#B3000000</color>
    <!-- Abdunklung hinter dem Umschalter -->
    <color name="mate_scrim_switcher">#99000000</color>
    <!-- Anrufkarte -->
    <color name="mate_card_solid">#F2161B22</color>
    <!-- Griff der Teilung -->
    <color name="mate_handle">#6E7681</color>
    <!-- Anruf annehmen, Anruf laeuft -->
    <color name="mate_call">#2EA043</color>
    <!-- Auflegen -->
    <color name="mate_call_end">#DA3633</color>
    <!-- Ziel, Warnung -->
    <color name="mate_danger">#F85149</color>
    <!-- Punkt: Mikrofon in Gebrauch -->
    <color name="mate_mic">#FF9F0A</color>
    <!-- Punkt: Kamera in Gebrauch -->
    <color name="mate_camera">#30D158</color>
    <!-- Kartenattrappe: Land -->
    <color name="mate_map_land">#16212B</color>
    <!-- Rand der Route -->
    <color name="mate_route_edge">#0A4A40</color>
    <!-- Hof um die eigene Position -->
    <color name="mate_route_halo">#551DE9B6</color>
    <!-- leiser Hinweis: kein Internet -->
    <color name="mate_warn">#FFA94D</color>
    <!-- O210: the light plate the charging networks' logos stand on (their colours are made for white) -->
    <color name="mate_logo_plate">#F4F6F5</color>
    <!-- Route, die noch zu fahren ist: die Kontrastfarbe -->
    <color name="mate_route">@color/mate_accent</color>
    <!-- the edge of cards floating over the map (O207): a solid contour instead of a soft shadow - a shadow over the moving
         map flickered in the car's video -->
    <color name="mate_float_edge">#0A1018</color>
    <!-- the routes not chosen in the preview (F5): quiet grey under the chosen one, as Google shows them -->
    <color name="mate_route_alt">#8A9AA6</color>
    <color name="mate_route_alt_edge">#4A5862</color>
    <!-- Speed limit sign of Mate Navi (wish of 16.11.2026, N2: the country's own signs) - Germany: white face, red ring -->
    <color name="mate_sign_face">#FFFFFF</color>
    <color name="mate_sign_ring">#E1251B</color>
    <color name="mate_sign_text">#111111</color>
